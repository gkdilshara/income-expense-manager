# Income & Expenses Manager CLI - Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database Backend ─────────────────────────────────────────────────────────
# Options: "json" or "mysql"  (can also be toggled from Settings menu)
DB_BACKEND=json

# ─── MySQL Configuration ──────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=income_expenses_manager

# ─── JSON Storage ─────────────────────────────────────────────────────────────
JSON_DATA_DIR=data

# ─── Sync Settings ────────────────────────────────────────────────────────────
# Auto-sync between JSON and MySQL when both are configured
AUTO_SYNC=true
SYNC_INTERVAL_MINUTES=5

# ─── App Settings ─────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
DATE_FORMAT=%Y-%m-%d
